{
  "title": "DevOps Revision Tracker",
  "uid": "revision-tracker",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Application targets UP",
      "id": 1,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(up{namespace=\"revision-tracker\", job=\"backend\"})",
          "legendFormat": "healthy replicas"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request rate",
      "id": 2,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"revision-tracker\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CPU utilization",
      "id": 3,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total{namespace=\"revision-tracker\"}[5m]))",
          "legendFormat": "CPU cores"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory utilization",
      "id": 4,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 524288000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{namespace=\"revision-tracker\"})",
          "legendFormat": "resident memory"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "95th percentile latency",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"revision-tracker\"}[5m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status code",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"revision-tracker\"}[5m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    }
  ]
}
